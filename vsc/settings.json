{
    "vim.leader": "<space>",

    "vim.handleKeys": {
        "<C-h>": false,
        "<C-j>": false,
        "<C-k>": false,
        "<C-l>": false
    },

    "vim.hlsearch": true,
    "vim.searchHighlightColor": "#ffff0040",
    "vim.searchMatchColor": "#ffff00",
    "vim.searchMatchTextColor": "#000000",

    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": ["g", "r"],
            "commands": ["editor.action.goToReferences"]
        },
        {
            "before": ["K"],
            "commands": ["editor.action.showHover"]
        }
    ]
}
